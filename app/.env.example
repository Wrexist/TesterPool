# Copy to .env.local for development, or paste into your host's environment
# settings. `.env.local` is gitignored; never commit a filled-in copy.

# ---------------------------------------------------------------- required
# Without these two the app builds and boots, but every page renders its empty
# state: flags fall back to FLAG_DEFAULTS and every query returns nothing.
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ---------------------------------------------------------------- optional
# The absolute origin Stripe Checkout returns the buyer to, and the base for
# referral links. Falls back to VERCEL_URL, then http://localhost:3000, so it
# only needs setting on a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Exposes /demo, which signs you in as a seeded developer without a mailbox.
# Anything other than the literal string "true" 404s the route. Never set this
# in production — see docs/BUILD-PLAN.md Phase 0.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# ---------------------------------------------------------------- payments
# All three are optional and the app is designed to run without them: the free
# tier is the product's spine, so missing keys degrade to an honest "payments
# are not configured" rather than a 500. Set all three or none.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely. It is read only by
# app/api/stripe/, which is the one place allowed to grant a paid benefit.
# It is not NEXT_PUBLIC_ and must never become so.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
