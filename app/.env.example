# Copy to .env.local for development, or paste into your host's environment
# settings. `.env.local` is gitignored; never commit a filled-in copy.

# ---------------------------------------------------------------- required
# Without these two the app builds and boots, but every page renders its empty
# state: flags fall back to FLAG_DEFAULTS and every query returns nothing.
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ---------------------------------------------------------------- optional
# The absolute origin Stripe Checkout returns the buyer to, and the base for
# referral links. Falls back to VERCEL_URL, then http://localhost:3000, so it
# only needs setting on a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- payments
# All three are optional and the app is designed to run without them: the free
# tier is the product's spine, so missing keys degrade to an honest "payments
# are not configured" rather than a 500. Set all three or none.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely. It is read only by
# app/api/stripe/, which is the one place allowed to grant a paid benefit.
# It is not NEXT_PUBLIC_ and must never become so.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- abuse
# Cloudflare Turnstile on signup. Both optional: without them the signup
# actions skip verification rather than 500ing, so set both or neither.
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile -> Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- observability
# Sentry error tracking. Optional; the SDK no-ops without a DSN.
# sentry.io -> Projects -> Create project (Next.js) -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# The next three are only needed for source-map upload at build time (better
# stack traces). Leave unset and the build just skips that step.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog product analytics. Optional; the client no-ops without a key.
# app.posthog.com -> Project settings -> Project API key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
